{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Debug IPC Server",
      "type": "node",
      "request": "launch",
      "program": "${workspaceFolder}/dist/ipc-server.js",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "/home/pat/.nvm/versions/node/v24.21.0/bin/node",
      "console": "integratedTerminal",
      "sourceMaps": true,
      "skipFiles": ["<node_internals>/**"],
      "preLaunchTask": "npm: build"
    },
    {
      "name": "Attach to GNOME Audio Backend",
      "type": "node",
      "request": "attach",
      "address": "127.0.0.1",
      "port": 9229,
      "restart": true,
      "sourceMaps": true,
      "outFiles": ["${workspaceFolder}/dist/**/*.js"],
      "skipFiles": ["<node_internals>/**"]
    }
  ]
}
